class BankAccount:
    def __init__(self, balance):
        self.__balance = balance       

    def __show_balance(self):       
        print("Balance:", self.__balance)

    def display_balance(self):
        self.__show_balance()

class SavingsAccount(BankAccount):
    def __init__(self, balance):
        super().__init__(balance)
        self._interest_rate = 5        

    def _calculate_interest(self, balance):
        return balance * self._interest_rate / 100

class Customer(SavingsAccount):
    def calculate(self):
        self.display_balance()

        balance = 10000
        interest = self._calculate_interest(balance)

        print("Interest:", interest)
        print("Protected Rate:", self._interest_rate)


c = Customer(10000)
c.calculate()